---
---
<div class="background-wrapper">
  <div class="cocoa-dust"></div>
  <div class="grain-overlay"></div>
</div>

<style>
  .background-wrapper {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
  }

  .cocoa-dust {
    position: absolute;
    inset: 0;
    background-image: url('/cacao.png');
    background-size: 250px;
    background-repeat: repeat;
    opacity: 0;
    animation: dustFadeIn 20s ease-in-out infinite alternate;
    z-index: -2;
    mix-blend-mode: multiply;
    pointer-events: none;
    filter: brightness(0.85) contrast(1.1); /* più scuro e ricco */
  }


  @keyframes dustFadeIn {
  0% {
    opacity: 0.1;
    transform: scale(1.05) translateY(-2%);
    filter: blur(2px) brightness(0.85);
  }
  100% {
    opacity: 0.4; /* leggermente più visibile */
    transform: scale(1) translateY(0%);
    filter: blur(0) brightness(0.85);
  }
}



  .grain-overlay {
    background-image: url('/cacao.png');
    background-repeat: repeat;
    background-size: 300px;
    opacity: 0.08; /* un po' più visibile */
    mix-blend-mode: multiply;
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    filter: brightness(0.9);
  }


  @keyframes chocolate-flow {
    0% { transform: translate(-10%, -10%) rotate(0deg); }
    100% { transform: translate(10%, 10%) rotate(360deg); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.05; }
    50% { transform: scale(1.2); opacity: 0.15; }
  }
</style>
