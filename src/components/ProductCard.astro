---
const { product } = Astro.props;
---

<div class="group bg-[#FFFCF5] shadow-choco-lg rounded-2xl cursor-pointer transition duration-300 hover:scale-105">
  <img src={product.image} alt={product.alt} class="w-full h-56 object-cover rounded-t-2xl"/>
  <div class="p-6 text-center">
    <h3 class="text-2xl font-semibold text-[#411900] mb-3">{product.title}</h3>
    <p class="text-[#5C2A12] text-sm mb-4">{product.description}</p>
    <div class="flex justify-center gap-2 flex-wrap">
      {product.tags.map(tag => (
        <span class="text-xs bg-[#e2d2c1] border border-[#d4b89d] px-3 py-1 rounded-full">{tag}</span>
      ))}
    </div>
  </div>
</div>
