---
import Layout from "../layouts/Layout.astro";
import ChiSiamo from "../components/ChiSiamo.jsx";
import Header from "../components/Header.jsx"; 
import Divider from "../components/Divider.astro";
import ProductShowcase from "../components/Totem.jsx";

import { products } from '../components/Products.mjs';
import Footer from "../components/Footer.astro";
---

<Layout>
	<Header client:load />
	<!-- Hero Section -->
	<section
            id="hero"
            class="relative z-10 container mx-auto text-center py-16 text-[#411900]"
          >
      <div class="p-2 rounded-3xl border-1.5px border-espresso shadow-choco-lg">
        <div class="backdrop-blur-md shadow-2xl rounded-3xl p-10 flex flex-col lg:flex-row items-center gap-6 xl:gap-8">

          <div class="relative overflow-visible z-10 inline-block">
            <img
              src="./pralina_caffe.png"
              class="relative z-20 w-64 lg:w-80 -translate-y-6 scale-105 shadow-[0_10px_30px_rgba(0,0,0,0.25)] [clip-path:circle(45%_at_50%_50%)]"
              alt="Pralina"
            />

          </div>     
          
          <!-- Testo e pulsante -->
          <div>
            <h1 class="text-5xl font-serif font-extrabold text-left">
              L'eccellenza del cioccolato artigianale
            </h1>
            <p class="mt-4 text-lg text-left">
              Dal cuore dell'Italia, il cioccolato più pregiato lavorato con passione e tradizione.
            </p>
            <div class="mt-6 text-left">
              <a href="#prodotti" class="btn-cacao-hero">
                Scopri i nostri prodotti
              </a>                                                  
            </div>
          </div>
        </div>
      </div>
	</section>

    <Divider />

    <!-- Chi Siamo Section -->
    <ChiSiamo client:load />

    <Divider />

  
    <!-- Sezione Prodotti in Evidenza -->
    <section id="prodotti" class="text-[#411900] py-24 px-4">
        <h2 class="text-4xl font-bold text-center font-serif mb-6">I Nostri Prodotti</h2>
        <p class="text-center text-lg max-w-2xl mx-auto mb-12">
          Scopri le nostre specialità artigianali create con ingredienti selezionati e passione per l'eccellenza.
        </p>  
            <ProductShowcase client:only="react" products={products} />
        
    </section>
      


    <!-- Lavora con noi -->
    <section id="lavora-con-noi" class="bg-overlay-dark backdrop-blur-sm rounded-2xl mx-4 py-16 my-12 text-center text-[#FAF3E0] shadow-choco">
      <div class="container mx-auto max-w-3xl">
        <h2 class="text-4xl font-serif font-bold mb-4">Lavora con noi</h2>
        <p class="max-w-xl mx-auto text-lg">
          Sei un’azienda interessata a collaborare? 🍫 Offriamo soluzioni personalizzate per la tua attività.
        </p>

        <div class="mt-6">
          <a href="javascript:void(0)" onclick="openModal()" class="btn-choco mt-6 inline-block">Contattaci ora</a>
        </div>
      </div>
    </section>

    <!-- Modale Google Form -->
    <div id="contact-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden backdrop-blur-sm bg-gradient-to-br from-[#00000099] to-[#41190066] transition-opacity duration-300">
      <div class="flex w-full h-full items-center justify-center overflow-auto">
        <div class="modal-content bg-white p-4 rounded-xl w-full max-w-2xl relative mt-10 mb-10 transform transition-all duration-300 scale-95 opacity-0" id="modal-box">
          <button onclick="closeModal()" class="absolute top-2 right-4 text-2xl font-bold text-[#411900]">&times;</button>
          <iframe 
            src="https://docs.google.com/forms/d/e/1FAIpQLSdABb3NBdMkmJ2ED5pZtodPvITHJAO4EjKz0437Egn0btKRQQ/viewform?embedded=true"
            width="100%"
            height="824"
            style="border: none; margin: 0;">
            Loading…
          </iframe>
        </div>
      </div>
    </div>
    <!--

    <section class="card-choco max-w-xl mx-auto my-16 text-center">
        <h2 class="text-2xl font-semibold mb-2">📬 Rimani aggiornato</h2>
        <p class="mb-4">Iscriviti alla nostra newsletter per ricevere offerte esclusive e news dal mondo del cioccolato.</p>
        <form class="flex flex-col sm:flex-row gap-3 items-center justify-center">
          <input type="email" placeholder="Inserisci la tua email" class="input input-bordered w-full sm:w-auto" required />
          <button type="submit" class="btn-choco">Iscriviti</button>
        </form>
    </section>
  -->
<Footer />

<script is:inline>
  function openModal() {
  const modal = document.getElementById('contact-modal');
  const modalBox = document.getElementById('modal-box');

  if (modal && modalBox) {
    modal.classList.remove('hidden');
    modalBox.classList.remove('scale-95', 'opacity-0');
    modalBox.classList.add('scale-100', 'opacity-100');
  }
}

function closeModal() {
  const modal = document.getElementById('contact-modal');
  const modalBox = document.getElementById('modal-box');

  if (modal && modalBox) {
    modalBox.classList.remove('scale-100', 'opacity-100');
    modalBox.classList.add('scale-95', 'opacity-0');

    // Usa setTimeout per la transizione, 300ms come specificato nel CSS
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 300);
  }
}

  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.querySelector('[onclick="openModal()"]');
    const closeBtn = document.querySelector('[onclick="closeModal()"]');

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
  });
</script>



</Layout>
