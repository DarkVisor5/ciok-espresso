---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="min-h-screen flex flex-col items-center justify-center text-center text-[#411900] px-4">
    <img 
      src="/ordina.png" 
      alt="Coming Soon Ciok Espresso" 
      class="max-w-md w-full mb-8 rounded-xl shadow-choco"
    />
    <h1 class="text-4xl font-bold font-serif mb-4">🍫 E-shop in arrivo!</h1>
    <p class="text-lg mb-6 max-w-xl">
      Stiamo lavorando per offrirti la possibilità di ordinare online i tuoi prodotti preferiti.
      Torna a trovarci presto per scoprire il nostro e-commerce!
    </p>
    <a href="/" class="btn-choco">Torna alla Home</a>
  </section>
</Layout>
